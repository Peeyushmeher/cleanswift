{
  "expo": {
    "name": "cleanswift",
    "slug": "cleanswift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cleanswift_logo_1024x1024.png",
    "scheme": "cleanswift",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cleanswift.app",
      "buildNumber": "2",
      "icon": "./assets/cleanswift_logo_1024x1024.png",
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.cleanswift",
          "merchant.com.cleanswift"
        ],
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app uses the camera to scan payment cards and capture photos for service documentation.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to set your profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/cleanswift_logo_1024x1024.png",
          "imageWidth": 400,
          "resizeMode": "cover",
          "backgroundColor": "#0a1929",
          "dark": {
            "backgroundColor": "#0a1929"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2e06ce0a-08c3-4d41-a30e-e000dcc8307e"
      }
    }
  }
}
