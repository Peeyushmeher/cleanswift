{
  "expo": {
    "name": "cleanswift",
    "slug": "cleanswift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cleanswift",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cleanswift.app",
      "entitlements": {
        "com.apple.developer.in-app-payments": [
          "merchant.com.cleanswift",
          "merchant.com.cleanswift"
        ]
      },
      "ios": {
        "infoPlist": {
          "ITSAppUsesNonExemptEncryption": false,
          "NSCameraUsageDescription": "This app uses the camera to scan payment cards and capture photos for service documentation."
        }
      },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.cleanswift",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2e06ce0a-08c3-4d41-a30e-e000dcc8307e"
      }
    }
  }
}
